; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Sudoku"
config/description="A quiet space to think."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/image="res://assets/splash-icon.png"
boot_splash/bg_color=Color(0.968627, 0.960784, 0.937255, 1)
config/use_custom_user_dir=true
config/custom_user_dir_name="Sudoku"

[autoload]

Store="*res://scripts/app_store.gd"

[display]

window/size/viewport_width=430
window/size/viewport_height=860
window/size/window_width_override=430
window/size/window_height_override=860
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_size=16

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.968627, 0.960784, 0.937255, 1)

[audio]

driver/enable_input=false
